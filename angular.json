{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui": {
      "projectType": "library",
      "root": "projects/ui",
      "sourceRoot": "projects/ui",
      "prefix": "hlm",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "defaultConfiguration": "production",
          "options": {
            "project": "projects/ui/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui/tsconefig.lib.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui/tsconfig.spec.json",
            "setupFiles": [
              "testing/vitest-setup.ts"
            ]
          }
        }
      }
    },
    "storybook": {
      "projectType": "application",
      "root": "projects/storybook",
      "sourceRoot": "projects/storybook",
      "architect": {
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/storybook/.storybook",
            "tsConfig": "projects/storybook/.storybook/tsconfig.json",
            "styles": [
              "projects/storybook/.storybook/styles.css"
            ],
            "compodoc": false,
            "port": 6006,
            "browserTarget": "storybook:build-storybook",
            "experimentalZoneless": true
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/storybook/.storybook",
            "tsConfig": "projects/storybook/.storybook/tsconfig.json",
            "styles": [
              "projects/storybook/.storybook/styles.css"
            ],
            "compodoc": false,
            "outputDir": "dist/storybook",
            "browserTarget": "storybook:build-storybook",
            "experimentalZoneless": true
          }
        }
      }
    },
    "portal": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/portal",
      "sourceRoot": "projects/portal/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/portal/src/main.ts",
            "tsConfig": "projects/portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/portal/public"
              }
            ],
            "styles": [
              "projects/portal/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "700kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/portal/src/environments/environment.ts",
                  "with": "projects/portal/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portal:build:production"
            },
            "development": {
              "buildTarget": "portal:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/portal/tsconfig.spec.json",
            "coverageExclude": [
              "projects/portal/src/mocks/**",
              "projects/portal/src/testing/**"
            ],
            "setupFiles": [
              "testing/vitest-setup.ts"
            ]
          }
        }
      }
    }
  }
}
