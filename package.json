{
  "name": "supermercado",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve portal",
    "build": "ng build ui && ng build portal",
    "build:ui": "ng build ui",
    "build:portal": "ng build portal",
    "build:homolog": "ng build ui && ng build portal -c homologation",
    "storybook": "ng run storybook:storybook",
    "build-storybook": "ng run storybook:build-storybook",
    "lint": "eslint projects",
    "lint:fix": "eslint projects --fix",
    "format": "prettier --write \"projects/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,css,json}\"",
    "verify": "npm run format:check && npm run lint && npm run build && npm run build-storybook"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@azure/msal-browser": "^5.25.1",
    "@tanstack/angular-query-experimental": "^5.104.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.8.1",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
